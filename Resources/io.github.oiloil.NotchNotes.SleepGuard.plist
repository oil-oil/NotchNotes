<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.oiloil.NotchNotes.SleepGuard</string>
    <key>BundleProgram</key>
    <string>Contents/Library/LaunchServices/NotchNotesSleepHelper</string>
    <key>MachServices</key>
    <dict>
        <key>io.github.oiloil.NotchNotes.SleepGuard</key>
        <true/>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <array><string>io.github.oiloil.NotchNotes</string></array>
    <key>KeepAlive</key>
    <true/>
    <key>AbandonProcessGroup</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>1</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
